{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jasper-pokedex/national-dex.schema.json",
  "title": "Jasper's Pokédex National Identity Schema",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["globalSpeciesId", "name"],
        "properties": {
          "globalSpeciesId": { "type": "integer", "minimum": 1 },
          "globalFormId": { "type": ["string", "null"] },
          "name": { "type": "string", "minLength": 1 },
          "forms": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
